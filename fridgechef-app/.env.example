# FridgeChef app environment
#
# Copy to `.env` (git-ignored) and adjust. Every value is optional in mock mode.
# All variables are read in ONE place: src/services/config.ts (validated with Zod).
# Restart `npx expo start` (with `-c` to clear the cache) after changing values.
#
# SECURITY: anything prefixed EXPO_PUBLIC_ is compiled into the app bundle and can be
# extracted from it. The key below must be one intended for a client (for example a
# rate-limited key for your own backend). A secret LLM-provider key must stay on a
# server, never in this app.

# `mock` (on-device SQLite mock database, no network) or `http` (the real backend).
EXPO_PUBLIC_API_MODE=mock

# Backend base URL, e.g. https://api.example.com (no trailing slash needed).
# Required when EXPO_PUBLIC_API_MODE=http - the app fails fast at startup without it.
EXPO_PUBLIC_API_BASE_URL=

# API key sent with every request. Empty = no auth header is sent.
EXPO_PUBLIC_API_KEY=

# Header name for the key, e.g. `Authorization` or `x-api-key`. Default: Authorization
EXPO_PUBLIC_API_AUTH_HEADER=Authorization

# Prefix before the key, e.g. `Bearer` -> "Authorization: Bearer <key>".
# Leave it empty (`EXPO_PUBLIC_API_AUTH_SCHEME=`) to send the raw key.
# If the line is removed entirely, the default `Bearer` applies.
EXPO_PUBLIC_API_AUTH_SCHEME=Bearer

# Per-request timeout in ms (ingredient detection can be slow). Default: 30000
EXPO_PUBLIC_API_TIMEOUT_MS=30000

# Mock mode only: simulated latency in ms. Default: 900
EXPO_PUBLIC_MOCK_LATENCY_MS=900

# Mock mode only: 0-1 chance that a mock call fails, to exercise error states. Default: 0
EXPO_PUBLIC_MOCK_FAILURE_RATE=0
