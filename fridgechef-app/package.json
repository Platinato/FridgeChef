    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "test-renderer": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
